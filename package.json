{
  "name": "steady",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An experimental, browser-only sound and breathing tool for calming down, riding urges, relaxing, sleeping and focusing. Not a medical device.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshots": "node tools/screenshots.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.3.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.20.5",
    "playwright": "^1.56.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
